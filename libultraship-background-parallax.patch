+void Interpreter::PopBackgroundScopes() {
+    const size_t depth = g_exec_stack.cmd_stack.size();
+    while (!mBackgroundScopes.empty() && mBackgroundScopes.back() == depth) {
+        mBackgroundScopes.pop_back();
+    }
+}
